# KOSA Backend Environment Variables - Local Development

# 서버 설정
PORT=3001
NODE_ENV=development

# 개발 환경 설정 (외부 서비스 비활성화)
DISABLE_REDIS=true
DISABLE_KAFKA=true
DISABLE_DATABASE=true

# Kafka 설정 (비활성화됨)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=kosa-backend
KAFKA_GROUP_ID=kosa-backend-group

# Redis 설정 (비활성화됨)
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 데이터베이스 설정 (비활성화됨)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=kosa
DB_PORT=5432

# JWT 설정
JWT_SECRET=kosa-jwt-secret-key-for-development
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=kosa-jwt-refresh-secret-key-for-development
JWT_REFRESH_EXPIRES_IN=7d

# 로깅 설정
LOG_LEVEL=info

# 외부 서비스 설정 (Mock 서버 사용)
ANALYSIS_SERVER_URL=http://localhost:8000
CRAWLING_SERVER_URL=http://localhost:8001
USE_MOCK_SERVICES=true